    "@vitest/coverage-v8": "^4.1.2",
    "@vitest/ui": "^4.1.1",
    "autoprefixer": "^10.4.23",
    "babel-plugin-formatjs": "^10.5.39",
    "concurrently": "^9.2.1",
    "cssnano": "^7.1.3",
    "npm-run-all": "^4.1.5",
    "picocolors": "^1.1.1",
    "playwright": "^1.58.2",
    "postcss": "^8.5.6",
    "postcss-selector-lint": "^1.0.2",
    "prettier": "^3.6.2",
    "sass-embedded": "^1.97.3",
    "storybook": "^10.3.5",
    "storybook-react-intl": "^10.1.1",
    "type-fest": "^5.2.0",
