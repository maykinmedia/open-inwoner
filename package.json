{
  "name": "open_inwoner",
  "version": "1.0.0-alpha.0",
  "description": "open_inwoner project",
  "main": "src/static/open_inwoner/js/open_inwoner.js",
  "directories": {
    "doc": "doc"
  },
  "scripts": {
    "build": "npm run collect && npm run bundle && npm run bundle:react",
    "bundle": "webpack",
    "bundle:react": "vite build && npm run makemessages && npm run compilemessages",
    "collect": "cp -r node_modules/leaflet/dist/images src/open_inwoner/static/bundles && cp -r node_modules/material-icons/iconfont/*.woff src/open_inwoner/static/bundles && cp -r node_modules/material-icons/iconfont/*.woff2 src/open_inwoner/static/bundles && cp -r node_modules/@fortawesome/fontawesome-free/webfonts src/open_inwoner/static/",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "check-linting": "prettier src/open_inwoner/js src/open_inwoner/scss src/open_inwoner/react -c",
    "fix-linting": "prettier src/open_inwoner/js src/open_inwoner/scss src/open_inwoner/react -w ",
    "watch": "npm run collect && webpack -w",
    "watch:react": "npm run collect && vite build --watch --mode=dev",
    "watch:react:browser-sync": "npm run collect && vite build --watch & npm run browser-sync",
    "browser-sync": "browser-sync start --proxy 'localhost:8000' --files 'src/open_inwoner/static/bundles/**/*.*' --port '8001'",
    "makemessages-nl": "formatjs extract 'src/open_inwoner/react/**/*.{js,ts,tsx}' --ignore='**/*.d.ts' --format src/open_inwoner/react/i18n/i18n-formatter.js --out-file src/open_inwoner/react/i18n/locales/nl.json --id-interpolation-pattern '[sha512:contenthash:base64:6]'",
    "makemessages-en": "formatjs extract 'src/open_inwoner/react/**/*.{js,ts,tsx}' --ignore='**/*.d.ts' --format src/open_inwoner/react/i18n/i18n-formatter.js --out-file src/open_inwoner/react/i18n/locales/en.json --id-interpolation-pattern '[sha512:contenthash:base64:6]'",
    "makemessages": "npm run makemessages-nl && npm run makemessages-en",
    "compilemessages": "formatjs compile-folder --ast src/open_inwoner/react/i18n/locales src/open_inwoner/react/locale/compiled"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/maykinmedia/open_inwoner.git"
  },
  "author": "Maykin Media",
  "license": "UNLICENSED",
  "homepage": "https://maykinmedia.nl",
  "dependencies": {
    "@ckeditor/ckeditor5-autoformat": "^33.0.0",
    "@ckeditor/ckeditor5-basic-styles": "^33.0.0",
    "@ckeditor/ckeditor5-block-quote": "^33.0.0",
    "@ckeditor/ckeditor5-dev-utils": "^30.1.3",
    "@ckeditor/ckeditor5-editor-classic": "^33.0.0",
    "@ckeditor/ckeditor5-essentials": "^33.0.0",
    "@ckeditor/ckeditor5-heading": "^33.0.0",
    "@ckeditor/ckeditor5-image": "^33.0.0",
    "@ckeditor/ckeditor5-indent": "^33.0.0",
    "@ckeditor/ckeditor5-link": "^33.0.0",
    "@ckeditor/ckeditor5-list": "^33.0.0",
    "@ckeditor/ckeditor5-markdown-gfm": "^33.0.0",
    "@ckeditor/ckeditor5-paragraph": "^33.0.0",
    "@ckeditor/ckeditor5-table": "^33.0.0",
    "@ckeditor/ckeditor5-theme-lark": "^33.0.0",
    "@emotion/react": "^11.5.0",
    "@emotion/styled": "^11.3.0",
    "@fortawesome/fontawesome-free": "^6.4.2",
    "@joeattardi/emoji-button": "^4.6.4",
    "@open-inwoner/design-tokens": "^0.0.11-alpha.2",
    "@tarekraafat/autocomplete.js": "^10.2.6",
    "bem.js": "^1.0.10",
    "caniuse-lite": "^1.0.30001707",
    "emojibase-data": "^7.0.1",
    "escape-html": "^1.0.3",
    "flatpickr": "^4.6.9",
    "gumshoejs": "^5.1.2",
    "html-minifier": "^4.0.0",
    "htmx.org": "^2.0.4",
    "inline-css": "^3.0.0",
    "leaflet": "^1.7.1",
    "material-icons": "^1.13.12",
    "microscope-sass": "latest",
    "proj4leaflet": "^1.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-intl": "^7.1.11",
    "style-loader": "^2.0.0"
  },
  "devDependencies": {
