    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/leaflet": "^1.7.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@utrecht/component-library-css": "7.1.5",
    "@vitest/ui": "^3.2.4",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^9.0.0",
    "babel-loader": "^8.2.5",
    "babel-plugin-formatjs": "^10.5.39",
    "browser-sync": "^3.0.4",
    "core-js": "^3.41.0",
    "css-loader": "latest",
    "cssnano": "latest",
    "jest": "^30.0.3",
    "mini-css-extract-plugin": "latest",
    "mocha": "^9.2.0",
    "postcss": "^8.5.6",
    "postcss-loader": "^4.3.0",
    "postcss-mixins": "^12.0.0",
    "postcss-preset-env": "^7.0.1",
    "postcss-selector-lint": "^1.0.2",
    "prettier": "^2.5.1",
    "prettier-stylelint": "^0.4.2",
    "raw-loader": "^4.0.2",
    "regenerator-runtime": "^0.14.1",
    "sass": "latest",
    "sass-loader": "latest",
    "simulant": "latest",
    "sinon": "latest",
    "stylelint": "^14.1.0",
    "stylelint-config-sass-guidelines": "^9.0.1",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "url-loader": "latest",
    "vite": "^6.3.5",
