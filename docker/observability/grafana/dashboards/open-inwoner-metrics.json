{
  "id": null,
  "uid": "open-inwoner-metrics",
  "title": "Open Inwoner metrics",
  "description": "Application metrics defined in open_inwoner (accounts, cases, openzaak webhooks, openklant sync, concurrency utils), exported via OpenTelemetry -> otel-collector -> Prometheus. Counters are sum()-aggregated and gauges max()-aggregated across resource instances (app worker processes each report independently, so raw queries double-count/duplicate).",
  "tags": [
    "open-inwoner",
    "otel"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "label": "Datasource"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total users",
      "datasource": {
        "type": "datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "${datasource}"
          },
          "expr": "max(otel_oip_accounts_user_count{scope=\"global\", type=\"all\", login_type=\"\"})",
          "refId": "A",
          "legendFormat": "Total"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
