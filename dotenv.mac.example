GDAL_LIBRARY_PATH=/opt/homebrew/opt/gdal/lib/libgdal.dylib
LDFLAGS=-L/opt/homebrew/opt/libxml2/lib -L/opt/homebrew/opt/libxslt/lib -L/opt/homebrew/opt/libpq/lib -L/opt/homebrew/opt/xmlsec1/lib
CPPFLAGS=-I/opt/homebrew/opt/libxml2/include -I/opt/homebrew/opt/libxslt/include -I/opt/homebrew/opt/libpq/include -I/opt/homebrew/opt/xmlsec1/include
GEOS_LIBRARY_PATH=/opt/homebrew/opt/geos/lib/libgeos_c.dylib
JAVA_HOME=/opt/homebrew/opt/openjdk@17
DYLD_LIBRARY_PATH="/opt/homebrew/Cellar/poppler/25.01.0/lib:$DYLD_LIBRARY_PATH"
DYLD_FALLBACK_LIBRARY_PATH=/opt/homebrew/lib:$DYLD_FALLBACK_LIBRARY_PATH